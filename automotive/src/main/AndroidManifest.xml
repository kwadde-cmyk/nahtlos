<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.screen.portrait"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.screen.landscape"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <queries>
        <intent>
            <action android:name="android.car.intent.action.MEDIA_TEMPLATE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MUSIC" />
        </intent>
    </queries>

    <application
        android:name=".AutoApp"
        android:allowBackup="true"
        android:appCategory="audio"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nahtlos"
        android:usesCleartextTraffic="true">

        <meta-data
            android:name="com.android.automotive"
            android:resource="@xml/automotive_app_desc" />

        <!--
            Einrichten, Koppeln und NWC nur im Stand.
            Kein distractionOptimized: die Headunit sperrt die Activity während der Fahrt.
            Zusätzlich prüft ParkedGate CarUxRestrictions, falls der Bildschirm schon offen war.
        -->
        <!--
            Startseite ist die Wiedergabe, auch während der Fahrt.
            Keine Textfelder. Bibliothek öffnet das Mediencenter.
        -->
        <activity
            android:name=".NowPlayingActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
